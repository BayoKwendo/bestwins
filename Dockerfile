# Production image: build the CRA bundle, then serve it with nginx.

# ---------- build ----------
FROM node:24-bookworm-slim AS build

WORKDIR /app

# react-scripts 3.x runs webpack 4, which hashes with md4. OpenSSL 3 (Node 17+)
# removed md4 from the default provider, so the build needs the legacy one.
ENV NODE_OPTIONS=--openssl-legacy-provider
# source maps are large and are not served in production
ENV GENERATE_SOURCEMAP=false
# CRA treats warnings as errors when CI is set, and this project has many
ENV CI=false

COPY package.json package-lock.json ./
# package-lock.json must be generated by the same npm this image ships (11.x).
# npm 9 omits darwin-only optional deps (fsevents, nan, bindings,
# file-uri-to-path) from the lock, and npm 11 then rejects it as out of sync.
# If you regenerate the lock locally on older npm, use:
#   npx npm@11 install --package-lock-only --legacy-peer-deps
RUN npm ci --legacy-peer-deps

COPY . .
RUN npm run build

# ---------- serve ----------
FROM nginx:alpine AS serve

# nginx.conf serves /app and falls back to index.html for client side routing
COPY nginx.conf /etc/nginx/nginx.conf
COPY --from=build /app/build /app

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
