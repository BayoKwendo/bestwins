         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Happy tiny people gambling in online casino isolated flat vector illustration. Cartoon characters playing in roulette, poker, blackjack. Money and risk concept</rdf:li>
            </rdf:Alt>
         </dc:description>
