# Same build as Dockerfile, kept for deployments that sit behind an external
# proxy and want the container on port 80 without publishing 1616.

FROM node:24-bookworm-slim AS build

WORKDIR /app

ENV NODE_OPTIONS=--openssl-legacy-provider
ENV GENERATE_SOURCEMAP=false
ENV CI=false

COPY package.json package-lock.json ./
# package-lock.json must be generated by the same npm this image ships (11.x).
# npm 9 omits darwin-only optional deps (fsevents, nan, bindings,
# file-uri-to-path) from the lock, and npm 11 then rejects it as out of sync.
# If you regenerate the lock locally on older npm, use:
#   npx npm@11 install --package-lock-only --legacy-peer-deps
RUN npm ci --legacy-peer-deps

COPY . .
RUN npm run build

FROM nginx:alpine AS production-stage

COPY nginx.conf /etc/nginx/nginx.conf
COPY --from=build /app/build /app

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
